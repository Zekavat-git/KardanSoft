<Window x:Class="KardanSoft.Tools.KstpClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KardanSoft KSTP Test Client"
        Width="760"
        Height="700"
        MinWidth="680"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="KardanSoft KSTP Test Client"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="NanoPi communication and protocol diagnostic utility"
                               Margin="0,6,0,0"
                               Foreground="#606060"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="KSTP v1"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ProtocolStatusText"
                               Text="Self-test: checking..."
                               Margin="0,4,0,0"
                               Foreground="#606060"
                               HorizontalAlignment="Right"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- CONNECTION -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="18">

            <StackPanel>

                <TextBlock Text="Connection"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="NanoPi IP:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1"
                             x:Name="HostTextBox"
                             Text="192.168.50.20"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>


                    <TextBlock Grid.Column="3"
                               Text="Port:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="4"
                             x:Name="PortTextBox"
                             Text="5055"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>


                    <Button Grid.Column="6"
                            x:Name="ConnectButton"
                            Content="Connect"
                            Height="34"
                            MinWidth="110"
                            HorizontalAlignment="Right"
                            IsEnabled="False"
                            Click="ConnectButton_Click"/>

                </Grid>


                <StackPanel Orientation="Horizontal"
                            Margin="0,14,0,0">

                    <Ellipse x:Name="ConnectionIndicator"
                             Width="12"
                             Height="12"
                             Fill="#A0A0A0"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="ConnectionStatusText"
                               Text="Disconnected"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </StackPanel>

        </Border>


        <!-- COMMANDS -->

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="18">

            <StackPanel>

                <TextBlock Text="Locker Commands"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="Locker ID:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1"
                             x:Name="LockerIdTextBox"
                             Text="12"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>


                    <TextBlock Grid.Column="3"
                               Text="Person ID:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="4"
                             x:Name="PersonIdTextBox"
                             Text="KSTP_TEST_001"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>

                </Grid>


                <Grid Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="0"
                            x:Name="AllocateButton"
                            Content="Allocate Locker"
                            Height="38"
                            IsEnabled="False"
                            Click="AllocateButton_Click"/>


                    <Button Grid.Column="2"
                            x:Name="OpenButton"
                            Content="Open Locker"
                            Height="38"
                            IsEnabled="False"
                            Click="OpenButton_Click"/>


                    <Button Grid.Column="4"
                            x:Name="ReleaseButton"
                            Content="Release Locker"
                            Height="38"
                            IsEnabled="False"
                            Click="ReleaseButton_Click"/>

                </Grid>

            </StackPanel>

        </Border>


        <!-- LOG -->

        <Border Grid.Row="6"
                Background="White"
                CornerRadius="8"
                Padding="18"
                MinHeight="180">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid>

                    <TextBlock Text="Communication Log"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>


                    <Button x:Name="ClearLogButton"
                            Content="Clear"
                            Width="80"
                            Height="28"
                            HorizontalAlignment="Right"
                            Click="ClearLogButton_Click"/>

                </Grid>


                <TextBox Grid.Row="2"
                         x:Name="LogTextBox"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Background="#FAFAFA"
                         Padding="10"/>

            </Grid>

        </Border>

    </Grid>

</Window>
